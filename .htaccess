# Divadielko Galeria
# Hosting: websupport.sk (Apache + PHP)

Options -Indexes
DirectoryIndex index.php

AddDefaultCharset UTF-8

# Formaty, ktore starsi Apache nepozna
AddType image/avif .avif
AddType audio/ogg .opus
AddType video/mp4 .mp4 .m4v

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- HTTPS ---------------------------------------------------------
    # Odkomentujte az VTEDY, ked je pre domenu aktivny SSL certifikat
    # (vo Websupport admine: Sluzby > Webhosting > SSL certifikat).
    # Predtym by presmerovanie stranku rozbilo.
    #
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # --- Vnutornosti sa nikdy neservuju --------------------------------
    # (kazdy z tychto priecinkov ma aj vlastny .htaccess, toto je druha poistka)
    RewriteRule ^(includes|pages|storage|assets_original|tools)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^router\.php$ - [F,L]
    RewriteRule \.(md|sql|lock|log|dist)$ - [F,L]

    # --- Vsetko ostatne ide na index.php --------------------------------
    # Realne existujuce subory (obrazky, CSS, robots.txt) sa servuju priamo,
    # cokolvek ine zobrazi index.php - aj stare URL adresy z povodneho webu.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # CSS a JS sa odkazuju s ?v=<cas upravy>, takze mozu byt v cache dlho.
    <FilesMatch "\.(css|js|svg|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(avif|jpe?g|png|webp|gif|mp4|m4v|webm|opus|ogg|oga|mp3|m4a|wav)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain image/svg+xml application/javascript application/json
</IfModule>
