# Nahrate subory - nikdy sa nespustaju ako skript ani nezobrazuju ako stranka.
Options -Indexes -ExecCGI

<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|xhtml|svg|js|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
